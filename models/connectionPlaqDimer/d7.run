#!/bin/bash
#SBATCH --qos long
#SBATCH --partition gpu
#SBATCH -e slurm_logs/job-%N-%j.error
#SBATCH -o slurm_logs/job-%N-%j.out
#SBATCH --gres=gpu:1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=1
#SBATCH --mem=40G
#SBATCH --time=167:59:50
#SBATCH --exclude=i39

set -euo pipefail
module load gcc/11.3.0
module load cuda/11.8.0
source /home/chye/venvs/6adctmrg_Izar/bin/activate
bash ./run_stage.sh
