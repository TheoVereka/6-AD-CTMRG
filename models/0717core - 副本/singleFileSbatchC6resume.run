#!/bin/bash
#SBATCH --job-name=c6D9resume
#SBATCH --qos=long
#SBATCH --partition=h100
#SBATCH --gres=gpu:1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --mem=90G
#SBATCH --time=167:59:50
#SBATCH --output=output_%x_%j.log

set -euo pipefail
: "${J2:?J2 must be exported by submit_all_15.sh}"

module load nvhpc/24.7-mpi
module load cuda/12.5.1
source /home/pghosh/venvs/6adctmrg_Kuma/bin/activate

D=9
J2_TAG="${J2/./p}"
CHECKPOINT="/home/pghosh/0717Kuma/c6ypi_J2_${J2_TAG}_D9_chi108_best.pt"
OUTDIR="./Results_J2_c6ypi_${J2}/D_${D}"

if [[ ! -f "${CHECKPOINT}" ]]; then
    echo "Missing resume checkpoint: ${CHECKPOINT}" >&2
    exit 1
fi
mkdir -p "${OUTDIR}"

python /home/pghosh/0717Kuma/main_C3_resuming.py \
    --J2 "${J2}" \
    --ansatz c6ypi \
    --Ds "${D}" \
    --output-dir "${OUTDIR}" \
    --resume "${CHECKPOINT}"

echo "END OF JOB"
cp -r /scratch/pghosh/Working_AD_Honeycomb_July17 /home/pghosh/Data_Backup/
