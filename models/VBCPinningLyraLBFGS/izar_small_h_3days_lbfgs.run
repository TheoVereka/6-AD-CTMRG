#!/usr/bin/env bash
#SBATCH --qos=normal
#SBATCH --partition=gpu
#SBATCH --gres=gpu:1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=1
#SBATCH --mem=40G
#SBATCH --time=71:59:50
#SBATCH --exclude=i39
#SBATCH --output=smallh-%N-%j.out
#SBATCH --error=smallh-%N-%j.error

set -euo pipefail
: "${REPLICA:?REPLICA must be exported}"
[[ "${REPLICA}" == "1" ]] || { echo "replica 1 only" >&2; exit 2; }

module load gcc/11.3.0
module load cuda/11.8.0
source /home/chye/venvs/6adctmrg_Izar/bin/activate

BUNDLE_DIR="${BUNDLE_DIR:-${SLURM_SUBMIT_DIR:-${PWD}}}"
BUNDLE_DIR="$(cd -- "${BUNDLE_DIR}" && pwd)"
export BUNDLE_DIR
export STAGE_HOURS="${STAGE_HOURS:-14}"

bash "${BUNDLE_DIR}/izar_memory_guard.sh"
bash "${BUNDLE_DIR}/run_vbc_small_h_izar.sh"
