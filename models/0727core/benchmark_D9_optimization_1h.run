#!/bin/bash
#SBATCH --qos debug
#SBATCH --job-name=0727-D9-opt
#SBATCH --partition gpu
#SBATCH -e ./D9-opt-%N-%j.error
#SBATCH -o ./D9-opt-%N-%j.out
#SBATCH --gres=gpu:1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=1
#SBATCH --mem=40G
#SBATCH --time=00:59:50
#SBATCH --exclude=i39

echo "***** START D=9 PRODUCTION-CLOSURE BENCHMARK *****"
module load gcc/11.3.0
module load cuda/11.8.0
echo "STARTING AT $(date)"

source /home/chye/venvs/6adctmrg_Izar/bin/activate
export PYTHONUNBUFFERED=1

NEW_DIR="${NEW_DIR:-/home/chye/0727core}"
OUT_DIR="${OUT_DIR:-${NEW_DIR}/D9_chi108_debug}"

cd "${NEW_DIR}" || exit 2

python -u "${NEW_DIR}/main_C3.py" \
    --hours 0.95 \
    --ansatz twoc3 \
    --J2 0.265 \
    --Ds 9 \
    --chi-min 108 \
    --chi-max 108 \
    --chi-step 1 \
    --double \
    --gpu \
    --ngpu 1 \
    --output-dir "${OUT_DIR}"
STATUS=$?

echo "FINISHED AT $(date) WITH STATUS ${STATUS}"
echo "OUTPUT DIRECTORY: ${OUT_DIR}"
echo "***** END D=9 PRODUCTION-CLOSURE BENCHMARK *****"
exit "${STATUS}"
