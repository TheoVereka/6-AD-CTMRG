#!/bin/bash
##SBATCH --qos long
#SBATCH --job-name=0727-accuracy-D3
#SBATCH --partition gpu
#SBATCH -e ./accuracy-D3-%N-%j.error
#SBATCH -o ./accuracy-D3-%N-%j.out
#SBATCH --gres=gpu:1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=1
#SBATCH --mem=40G
#SBATCH --time=11:59:50
#SBATCH --exclude=i39

echo "***** START D=3 ACCURACY JOB *****"
module load gcc/11.3.0
module load cuda/11.8.0
echo "STARTING AT $(date)"

source /home/chye/venvs/6adctmrg_Izar/bin/activate
export PYTHONUNBUFFERED=1

OLD_DIR="${OLD_DIR:-/home/chye/0717core}"
NEW_DIR="${NEW_DIR:-/home/chye/0727core}"

cd "${NEW_DIR}" || exit 2

python -u "${NEW_DIR}/test_accuracy_D3.py" \
    --old-core "${OLD_DIR}/core_C3.py" \
    --new-core "${NEW_DIR}/core_C3.py" \
    --new-main "${NEW_DIR}/main_C3.py" \
    --device cuda \
    --D 3 \
    --chi 12 \
    --ctm-steps 3 \
    --power-iters 4 \
    --json "${NEW_DIR}/accuracy_D3_results.json"
STATUS=$?

echo "FINISHED AT $(date) WITH STATUS ${STATUS}"
echo "JSON: ${NEW_DIR}/accuracy_D3_results.json"
echo "***** END D=3 ACCURACY JOB *****"
exit "${STATUS}"
