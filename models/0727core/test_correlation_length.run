#!/bin/bash
#SBATCH --qos debug
#SBATCH --job-name=corr-length-test
#SBATCH --partition gpu
#SBATCH -e ./corr-length-test-%x-%N-%j.error
#SBATCH -o ./corr-length-test-%x-%N-%j.out
#SBATCH --gres=gpu:1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=1
#SBATCH --mem=40G
#SBATCH --time=00:59:50
#SBATCH --exclude=i39

echo "***** START CORRELATION-LENGTH VALIDATION *****"
module load gcc/11.3.0
module load cuda/11.8.0
echo "STARTING AT $(date)"

source /home/chye/venvs/6adctmrg_Izar/bin/activate
export PYTHONUNBUFFERED=1

RUN_DIR="${RUN_DIR:-/home/chye/0727core}"
cd "${RUN_DIR}" || exit 2

D_BOND="${1:?Pass D as the first job-script argument.}"
case "${D_BOND}" in
    3) CHI=24 ;;
    4) CHI=36 ;;
    5) CHI=50 ;;
    6) CHI=72 ;;
    *)
        echo "Unsupported D=${D_BOND}; expected one of 3,4,5,6."
        exit 2
        ;;
esac

EXTRA_ARGS=()
if [[ "${D_BOND}" == "3" ]]; then
    EXTRA_ARGS+=(--run-implementation-regressions)
fi

python -u "${RUN_DIR}/test_correlation_length.py" \
    --device cuda \
    --D "${D_BOND}" \
    --chi "${CHI}" \
    "${EXTRA_ARGS[@]}"
STATUS=$?

echo "FINISHED AT $(date) WITH STATUS ${STATUS}"
echo "***** END CORRELATION-LENGTH VALIDATION *****"
exit "${STATUS}"
