#!/bin/bash
#SBATCH --qos debug
#SBATCH --job-name=0727-D9-quick
#SBATCH --partition gpu
#SBATCH -e ./D9-quick-%N-%j.error
#SBATCH -o ./D9-quick-%N-%j.out
#SBATCH --gres=gpu:1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=1
#SBATCH --mem=40G
#SBATCH --time=00:59:50
#SBATCH --exclude=i39

echo "***** START D=9 ONE-HOUR BENCHMARK *****"
module load gcc/11.3.0
module load cuda/11.8.0
echo "STARTING AT $(date)"

source /home/chye/venvs/6adctmrg_Izar/bin/activate
export PYTHONUNBUFFERED=1

OLD_DIR="${OLD_DIR:-/home/chye/0717core}"
NEW_DIR="${NEW_DIR:-/home/chye/0727core}"

cd "${NEW_DIR}" || exit 2

python -u "${NEW_DIR}/benchmark_production_scale.py" \
    --old-core "${OLD_DIR}/core_C3.py" \
    --new-core "${NEW_DIR}/core_C3.py" \
    --D 9 \
    --chi 108 \
    --power-iters 1 \
    --quick-accurate \
    --json "${NEW_DIR}/production_D9_chi108_quick_results.json"
STATUS=$?

echo "FINISHED AT $(date) WITH STATUS ${STATUS}"
echo "JSON: ${NEW_DIR}/production_D9_chi108_quick_results.json"
echo "***** END D=9 ONE-HOUR BENCHMARK *****"
exit "${STATUS}"
