#!/usr/bin/env bash
#SBATCH --qos=long
#SBATCH --partition=gpu
#SBATCH --gres=gpu:1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=1
#SBATCH --mem=40G
#SBATCH --time=24:00:00
#SBATCH --exclude=i39
#SBATCH --job-name=LP5a02030p
#SBATCH --output=slurm_logs/%x-%N-%j.out
#SBATCH --error=slurm_logs/%x-%N-%j.error

set -euo pipefail
module load gcc/11.3.0
module load cuda/11.8.0
source /home/chye/venvs/6adctmrg_Izar/bin/activate

export TASK_FAMILY="task_pin_D5_h0p02_adam"
export STAGE_KIND="pin_h"
export MAIN_KIND="adam-lbfgs"
export D="5"
export CHI="50"
export CTM_STEPS="50"
export J2="0.30"
export STAGE_HOURS="23.5"
export VBC_FIELD="0.02"
export MEAN_FIELD_START="1"
export SEED_NUMBER="8502006"
export OUTPUT_REL="Results_LastIzar/task_pin_D5_h0p02_adam/J2_0p30/h_0p02"
export INPUT_REL=""

BUNDLE_DIR="${BUNDLE_DIR:-${SLURM_SUBMIT_DIR:-${PWD}}}"
export BUNDLE_DIR
bash "${BUNDLE_DIR}/run_stage.sh"
