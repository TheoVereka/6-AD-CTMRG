#!/usr/bin/env bash
#SBATCH --qos=normal
#SBATCH --partition=gpu
#SBATCH --gres=gpu:1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=1
#SBATCH --mem=40G
#SBATCH --time=71:59:50
#SBATCH --exclude=i39
#SBATCH --job-name=L3l6270z
#SBATCH --output=slurm_logs/%x-%N-%j.out
#SBATCH --error=slurm_logs/%x-%N-%j.error

set -euo pipefail
module load gcc/11.3.0
module load cuda/11.8.0
source /home/chye/venvs/6adctmrg_Izar/bin/activate

export TASK_FAMILY="task3_D6_lbfgs_pin"
export STAGE_KIND="pin_h0"
export MAIN_KIND="lbfgs"
export D="6"
export CHI="72"
export CTM_STEPS="50"
export J2="0.27"
export STAGE_HOURS="11"
export VBC_FIELD="0"
export MEAN_FIELD_START="0"
export SEED_NUMBER="3060060"
export OUTPUT_REL="Results_LastIzar/task3_D6_lbfgs_pin/J2_0p27/h_0"
export INPUT_REL="Results_LastIzar/task3_D6_lbfgs_pin/J2_0p27/h_0p005/sweep_D6_chi72_best.pt"

BUNDLE_DIR="${BUNDLE_DIR:-${SLURM_SUBMIT_DIR:-${PWD}}}"
