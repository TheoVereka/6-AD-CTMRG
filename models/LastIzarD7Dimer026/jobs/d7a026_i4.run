#!/usr/bin/env bash
#SBATCH --qos=long
#SBATCH --partition=gpu
#SBATCH --gres=gpu:1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=1
#SBATCH --mem=40G
#SBATCH --time=167:59:50
#SBATCH --exclude=i39
#SBATCH --job-name=L7d26a4
#SBATCH --output=slurm_logs/%x-%N-%j.out
#SBATCH --error=slurm_logs/%x-%N-%j.error
set -euo pipefail
module load gcc/11.3.0
module load cuda/11.8.0
source /home/chye/venvs/6adctmrg_Izar/bin/activate
export TASK_FAMILY="adiabatic_duplicate_4" STAGE_KIND="adiabatic" MAIN_KIND="lbfgs"
export SEED_NUMBER="726004" MEAN_FIELD_START="0" VBC_FIELD="0"
export OUTPUT_REL="Results_D7DimerJ2_0p26/adiabatic/duplicate_4"
export INPUT_REL="seeds/D7_J2_0p265_dimer_tensor_best.pt"
BUNDLE_DIR="${BUNDLE_DIR:-${SLURM_SUBMIT_DIR:-${PWD}}}"; export BUNDLE_DIR
bash "${BUNDLE_DIR}/run_stage.sh"
