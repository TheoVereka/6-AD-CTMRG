#!/bin/bash
##SBATCH --qos long
#SBATCH --partition gpu
#SBATCH -e ./job-%N-%j.error
#SBATCH -o ./job-%N-%j.out
#SBATCH --gres=gpu:1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=1
#SBATCH --mem=40G
#SBATCH --time=71:59:50
#SBATCH --exclude=i39

# Izar replica 1: resume an existing twoC3 tensor and follow both pinning
# sectors within the three-day allocation (one branch per submitted job).
set -euo pipefail
: "${REPLICA:?REPLICA must be exported}"
: "${SEED_CKPT:?replica 1 requires a bundled existing tensor}"
[[ "${REPLICA}" == "1" ]] || { echo "3daysResumingjob.run is replica 1 only" >&2; exit 2; }

echo "***** START OF IZAR REPLICA 1 *****"
module load gcc/11.3.0
module load cuda/11.8.0
source /home/chye/venvs/6adctmrg_Izar/bin/activate

# Slurm executes a spool copy of this script, so BASH_SOURCE points into
# /var/spool/slurmd rather than to the submitted bundle.
BUNDLE_DIR="${BUNDLE_DIR:-${SLURM_SUBMIT_DIR:-${PWD}}}"
BUNDLE_DIR="$(cd -- "${BUNDLE_DIR}" && pwd)"
bash "${BUNDLE_DIR}/izar_memory_guard.sh"
export STAGE_HOURS="${STAGE_HOURS:-12}"
bash "${BUNDLE_DIR}/run_vbc_branch.sh"

echo "***** END OF IZAR REPLICA 1 *****"
